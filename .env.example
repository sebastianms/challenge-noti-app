# SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@example.com

# SendGrid Signed Webhooks (Ed25519 public key from SendGrid portal)
SENDGRID_WEBHOOK_PUBLIC_KEY=your_ed25519_public_key_base64

# Audit UI — HTTP Basic auth (Phase 7 reemplaza con SSO)
AUDIT_BASIC_AUTH_USER=admin
AUDIT_BASIC_AUTH_PASSWORD=changeme

# Partition retention (meses; default 6)
AUDIT_RETENTION_MONTHS=6

# DigestScheduler (feature 004-rules-engine)
DIGEST_SCHEDULER_BATCH_SIZE=50
DIGEST_SCHEDULER_SLEEP_INTERVAL=60

<nav data-admin-sidebar class="w-56 bg-gray-900 text-gray-200 flex flex-col flex-shrink-0 min-h-screen">
  <div class="px-4 py-5 border-b border-gray-700">
    <%= link_to admin_dashboard_path,
          class: "text-sm font-semibold text-white tracking-wide uppercase hover:text-indigo-300 transition" do %>
      Noti Central
    <% end %>
  </div>

  <div class="flex-1 px-2 py-4 space-y-6 overflow-y-auto">
    <%# Sección: Operación %>
    <div>
      <p class="px-2 mb-1 text-xs font-semibold text-gray-500 uppercase tracking-wider">Operación</p>
      <% if Admin::RoleAuthorizer.allow?(current_admin_user.role, section: :dashboard) %>
        <%= nav_link_to "Dashboard", admin_dashboard_path, section: :dashboard %>
      <% end %>
      <% if Admin::RoleAuthorizer.allow?(current_admin_user.role, section: :dlq) %>
        <%= nav_link_to "Cola de errores (DLQ)", admin_dlq_index_path, section: :dlq %>
      <% end %>
    </div>

    <%# Sección: Reglas %>
    <div>
      <p class="px-2 mb-1 text-xs font-semibold text-gray-500 uppercase tracking-wider">Reglas</p>
      <% if Admin::RoleAuthorizer.allow?(current_admin_user.role, section: :rules) %>
        <%= nav_link_to "Reglas", admin_rules_path, section: :rules %>
      <% end %>
      <% if Admin::RoleAuthorizer.allow?(current_admin_user.role, section: :templates) %>
        <%= nav_link_to "Templates", admin_templates_path, section: :templates %>
      <% end %>
    </div>

    <%# Sección: Auditoría %>
    <div>
      <p class="px-2 mb-1 text-xs font-semibold text-gray-500 uppercase tracking-wider">Auditoría</p>
      <% if Admin::RoleAuthorizer.allow?(current_admin_user.role, section: :audits) %>
        <%= nav_link_to "Auditorías", admin_audits_path, section: :audits %>
      <% end %>
      <% if Admin::RoleAuthorizer.allow?(current_admin_user.role, section: :blacklist_read) %>
        <%= nav_link_to "Blacklist", admin_blacklist_index_path, section: :blacklist_read %>
      <% end %>
    </div>
  </div>

  <%# Sección: Recursos %>
  <div class="px-2 py-4 border-t border-gray-700">
    <p class="px-2 mb-1 text-xs font-semibold text-gray-500 uppercase tracking-wider">Recursos</p>
    <%
      repo_url     = "https://github.com/sebastianms/challenge-noti-app"
      app_tour_url = "#{repo_url}/blob/main/docs/app-tour.md"
      runbook_url  = "#{repo_url}/blob/main/docs/runbook.md"
    %>
    <%= link_to app_tour_url, target: "_blank", rel: "noopener",
          class: "flex items-center gap-2 px-2 py-1.5 rounded text-sm text-gray-300 hover:bg-gray-800 hover:text-white transition" do %>
      <span>🗺️</span> Tour de la app
    <% end %>
    <%= link_to runbook_url, target: "_blank", rel: "noopener",
          class: "flex items-center gap-2 px-2 py-1.5 rounded text-sm text-gray-300 hover:bg-gray-800 hover:text-white transition" do %>
      <span>📋</span> Runbook operativo
    <% end %>
  </div>

  <div class="px-4 py-3 border-t border-gray-700 text-xs text-gray-400">
    <p class="truncate"><%= current_admin_user.email %></p>
    <p class="text-gray-500"><%= current_admin_user.role %></p>
    <%= button_to "Cerrar sesión", destroy_admin_user_session_path, method: :delete,
        class: "mt-2 text-xs text-gray-400 hover:text-white" %>
  </div>
</nav>

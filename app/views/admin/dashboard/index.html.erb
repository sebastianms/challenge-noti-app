<h2 class="text-xl font-semibold text-gray-800 mb-6">Dashboard</h2>

<div data-section="counters" class="grid grid-cols-2 gap-4 mb-6">
  <div class="bg-white rounded-xl border border-gray-200 p-6 text-center">
    <div class="text-4xl font-bold text-gray-900"><%= @snapshot[:queue_depth] %></div>
    <div class="text-sm text-gray-500 mt-1">Cola pendiente</div>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-6 text-center">
    <div class="text-4xl font-bold text-red-600"><%= @snapshot[:dlq_depth] %></div>
    <div class="text-sm text-gray-500 mt-1">Cola de errores (DLQ)</div>
  </div>
</div>

<div class="grid grid-cols-3 gap-4 mb-6">
  <div data-section="volume" class="col-span-2 bg-white rounded-xl border border-gray-200 p-6">
    <h3 class="text-sm font-semibold text-gray-700 mb-4">Volumen (últimos 7 días)</h3>
    <%= bar_chart @snapshot[:volume], height: "220px", colors: ["#4f46e5"] %>
  </div>
  <div data-section="filter-rate" class="bg-white rounded-xl border border-gray-200 p-6">
    <h3 class="text-sm font-semibold text-gray-700 mb-4">Tasa de filtrado</h3>
    <%= pie_chart @snapshot[:filter_rate], height: "220px",
          colors: ["#22c55e", "#ef4444", "#f97316", "#3b82f6"] %>
  </div>
</div>

<div data-section="error-rate" class="bg-white rounded-xl border border-gray-200 p-6">
  <h3 class="text-sm font-semibold text-gray-700 mb-4">Errores por tipo de notificación</h3>
  <% if @snapshot[:error_rate].empty? %>
    <p class="text-sm text-gray-400">Sin errores registrados.</p>
  <% else %>
    <%= render "shared/table", headers: ["Tipo", "Fallos"] do %>
      <% @snapshot[:error_rate].each do |type, count| %>
        <tr>
          <td class="px-4 py-2 text-sm text-gray-700"><%= type.presence || "(sin tipo)" %></td>
          <td class="px-4 py-2 text-sm font-semibold text-red-600 text-right"><%= count %></td>
        </tr>
      <% end %>
    <% end %>
  <% end %>
</div>

<div class="mt-6">
  <%= render "admin/shared/mock_data_button" %>
</div>

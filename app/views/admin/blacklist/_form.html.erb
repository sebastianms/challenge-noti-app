<%= form_with url: admin_blacklist_index_path, method: :post, local: true,
      class: "bg-white rounded-xl border border-gray-200 p-6 max-w-lg space-y-4" do |f| %>

  <div>
    <%= f.label :recipient, "Destinatario", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :recipient, required: true,
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
  </div>

  <div>
    <%= f.label :scope, "Scope", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :scope, [ "global", "type", "channel" ],
          {},
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
  </div>

  <div>
    <%= f.label :target, "Target", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :target, placeholder: "vacío si scope=global",
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
  </div>

  <div>
    <%= f.label :reason, "Motivo", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :reason, rows: 2,
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
  </div>

  <%= f.submit "Agregar a blacklist",
        class: "px-5 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition cursor-pointer" %>
<% end %>

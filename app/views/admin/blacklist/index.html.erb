<div class="flex items-center justify-between mb-6">
  <h2 class="text-xl font-semibold text-gray-800">Blacklist de destinatarios</h2>
</div>

<div class="bg-white rounded-xl border border-gray-200 p-4 mb-6">
  <%= form_with url: admin_blacklist_index_path, method: :get, local: true do |f| %>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-3">
      <div>
        <%= f.label :recipient, "Destinatario", class: "block text-xs font-medium text-gray-600 mb-1" %>
        <%= f.text_field :recipient, value: @filters[:recipient],
              class: "w-full px-2 py-1.5 border border-gray-300 rounded text-sm focus:ring-1 focus:ring-indigo-400 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :scope, "Scope", class: "block text-xs font-medium text-gray-600 mb-1" %>
        <%= f.select :scope, [ "", "global", "type", "channel" ], { selected: @filters[:scope] },
              class: "w-full px-2 py-1.5 border border-gray-300 rounded text-sm focus:ring-1 focus:ring-indigo-400 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :target, "Target", class: "block text-xs font-medium text-gray-600 mb-1" %>
        <%= f.text_field :target, value: @filters[:target],
              class: "w-full px-2 py-1.5 border border-gray-300 rounded text-sm focus:ring-1 focus:ring-indigo-400 focus:outline-none" %>
      </div>
      <div>
        <%= f.label :source, "Fuente", class: "block text-xs font-medium text-gray-600 mb-1" %>
        <%= f.select :source, [ "", "manual", "admin_ui", "hard_bounce", "dropped", "spamreport" ], { selected: @filters[:source] },
              class: "w-full px-2 py-1.5 border border-gray-300 rounded text-sm focus:ring-1 focus:ring-indigo-400 focus:outline-none" %>
      </div>
    </div>
    <div class="flex items-center gap-3">
      <%= f.submit "Buscar", class: "px-4 py-1.5 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition cursor-pointer" %>
      <%= link_to "Exportar CSV", admin_blacklist_index_path(@filters.merge(format: :csv)),
            class: "px-4 py-1.5 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition" %>
    </div>
  <% end %>
</div>

<p class="text-sm text-gray-500 mb-3">Total: <strong class="text-gray-800"><%= @total %></strong></p>

<%= render "shared/table",
      headers: ["Fecha", "Destinatario", "Scope", "Target", "Fuente", "Motivo", "Acciones"] do %>
  <%= render partial: "row", collection: @items, as: :entry %>
<% end %>

<div class="mt-8">
  <h3 class="text-base font-semibold text-gray-800 mb-4">Alta manual</h3>
  <%= render partial: "form" %>
</div>

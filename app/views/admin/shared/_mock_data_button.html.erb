<% if Admin::MockDataFeature.enabled? && current_admin_user&.role == "admin" %>
  <div class="mt-6 pt-5 border-t border-gray-200">
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
      <div class="flex items-start gap-3">
        <span class="text-xl mt-0.5">🧪</span>
        <div class="flex-1 min-w-0">
          <p class="text-sm font-semibold text-amber-800 mb-1">Generar datos de demo</p>
          <p class="text-xs text-amber-700 mb-3 leading-relaxed">
            Crea reglas, templates, blacklist, auditorías con timelines completos
            (enqueued → dispatched → delivered/filtered/failed) y entradas en DLQ con clases de error variadas.
          </p>
          <%= button_to "Generar data mock", admin_mock_data_path, method: :post,
                class: "inline-flex items-center gap-2 px-4 py-2 bg-amber-500 text-white text-sm font-semibold rounded-lg hover:bg-amber-600 transition cursor-pointer" %>
        </div>
      </div>
    </div>
  </div>
<% end %>

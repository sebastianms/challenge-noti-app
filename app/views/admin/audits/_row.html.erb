<tr class="hover:bg-gray-50">
  <td class="px-4 py-2 text-xs text-gray-500 whitespace-nowrap"><%= audit.created_at.strftime("%Y-%m-%d %H:%M") %></td>
  <td class="px-4 py-2 text-xs font-mono text-gray-700"><%= audit.correlation_id %></td>
  <td class="px-4 py-2 text-sm text-gray-700"><%= audit.recipient_canonical %></td>
  <td class="px-4 py-2 text-sm text-gray-600"><%= audit.notification_type || "—" %></td>
  <td class="px-4 py-2 text-sm"><%= audit.status %></td>
  <td class="px-4 py-2 text-sm text-gray-500"><%= audit.source %></td>
  <td class="px-4 py-2 text-sm text-gray-500"><%= audit.channel %></td>
  <td class="px-4 py-2 text-sm text-gray-500"><%= audit.metadata&.dig("reason") || "—" %></td>
  <td class="px-4 py-2 text-sm text-gray-500"><%= audit.metadata&.dig("rule_id") || "—" %></td>
  <td class="px-4 py-2 text-sm text-right">
    <%= link_to "Detalle", admin_audit_path(audit.correlation_id), class: "text-indigo-600 hover:text-indigo-800" %>
  </td>
</tr>

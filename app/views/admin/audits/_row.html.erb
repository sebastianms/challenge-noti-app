<tr>
  <td><%= audit.created_at.iso8601 %></td>
  <td><code><%= audit.correlation_id %></code></td>
  <td><%= audit.recipient_canonical %></td>
  <td><%= audit.notification_type || "—" %></td>
  <td><%= audit.status %></td>
  <td><%= audit.source %></td>
  <td><%= audit.channel %></td>
  <td><%= audit.metadata&.dig("reason") || "—" %></td>
  <td><%= audit.metadata&.dig("rule_id") || "—" %></td>
  <td><%= link_to "Detalle", admin_audit_path(audit.correlation_id) %></td>
</tr>

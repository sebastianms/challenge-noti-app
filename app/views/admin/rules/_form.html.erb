<%= form_with model: rule,
      url: rule.persisted? ? admin_rule_path(rule) : admin_rules_path,
      local: true,
      class: "bg-white rounded-xl border border-gray-200 p-6 max-w-lg space-y-4" do |f| %>

  <%= render "shared/form_errors", object: rule %>

  <div>
    <%= f.label :notification_type, "Tipo de notificación",
          class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :notification_type,
          disabled: rule.persisted?,
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 #{'bg-gray-100' if rule.persisted?}" %>
  </div>

  <div>
    <%= f.label :priority, "Prioridad", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :priority,
          options_for_select([["— ninguna —", nil], %w[critical critical], %w[standard standard], %w[bulk bulk]], rule.priority),
          {},
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
  </div>

  <div>
    <%= f.label :max_per_day, "Máx. por día", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :max_per_day, min: 1,
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
  </div>

  <div>
    <%= f.label :cooldown_seconds, "Cooldown (segundos)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :cooldown_seconds, min: 1,
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
  </div>

  <div>
    <%= f.label :digest_window_seconds, "Ventana digest (segundos)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :digest_window_seconds, min: 1,
          class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :enabled, class: "w-4 h-4 rounded border-gray-300 text-indigo-600" %>
    <%= f.label :enabled, "Regla activa", class: "text-sm text-gray-700" %>
  </div>

  <%= f.hidden_field :notification_type if rule.persisted? %>

  <div class="flex gap-3 pt-2">
    <%= f.submit rule.persisted? ? "Guardar cambios" : "Crear regla",
          class: "px-5 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition cursor-pointer" %>
    <%= link_to "Cancelar", admin_rules_path,
          class: "px-5 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition" %>
  </div>
<% end %>

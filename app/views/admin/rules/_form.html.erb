<%= form_with model: rule,
      url: rule.persisted? ? admin_rule_path(rule) : admin_rules_path,
      local: true,
      style: "background:#fff;padding:1.5rem;border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,.08);max-width:560px" do |f| %>

  <% if rule.errors.any? %>
    <div style="margin-bottom:1rem;padding:.75rem 1rem;background:#fdf0f0;border-radius:6px;color:#c0392b;font-size:.875rem">
      <% rule.errors.full_messages.each do |msg| %>
        <div><%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div style="margin-bottom:1rem">
    <%= f.label :notification_type, "Tipo de notificación", style: "display:block;font-size:.85rem;font-weight:600;margin-bottom:.3rem;color:#444" %>
    <%= f.text_field :notification_type,
          style: "width:100%;padding:.45rem .6rem;border:1px solid #ddd;border-radius:4px;font-size:.875rem",
          disabled: rule.persisted? %>
  </div>

  <div style="margin-bottom:1rem">
    <%= f.label :priority, "Prioridad", style: "display:block;font-size:.85rem;font-weight:600;margin-bottom:.3rem;color:#444" %>
    <%= f.select :priority,
          options_for_select([["— ninguna —", nil], %w[critical critical], %w[standard standard], %w[bulk bulk]], rule.priority),
          {},
          style: "width:100%;padding:.45rem .6rem;border:1px solid #ddd;border-radius:4px;font-size:.875rem" %>
  </div>

  <div style="margin-bottom:1rem">
    <%= f.label :max_per_day, "Máx. por día", style: "display:block;font-size:.85rem;font-weight:600;margin-bottom:.3rem;color:#444" %>
    <%= f.number_field :max_per_day, min: 1,
          style: "width:100%;padding:.45rem .6rem;border:1px solid #ddd;border-radius:4px;font-size:.875rem" %>
  </div>

  <div style="margin-bottom:1rem">
    <%= f.label :cooldown_seconds, "Cooldown (segundos)", style: "display:block;font-size:.85rem;font-weight:600;margin-bottom:.3rem;color:#444" %>
    <%= f.number_field :cooldown_seconds, min: 1,
          style: "width:100%;padding:.45rem .6rem;border:1px solid #ddd;border-radius:4px;font-size:.875rem" %>
  </div>

  <div style="margin-bottom:1rem">
    <%= f.label :digest_window_seconds, "Ventana digest (segundos)", style: "display:block;font-size:.85rem;font-weight:600;margin-bottom:.3rem;color:#444" %>
    <%= f.number_field :digest_window_seconds, min: 1,
          style: "width:100%;padding:.45rem .6rem;border:1px solid #ddd;border-radius:4px;font-size:.875rem" %>
  </div>

  <div style="margin-bottom:1.25rem;display:flex;align-items:center;gap:.5rem">
    <%= f.check_box :enabled, style: "width:1rem;height:1rem" %>
    <%= f.label :enabled, "Regla activa", style: "font-size:.875rem;color:#444" %>
  </div>

  <%= f.hidden_field :notification_type if rule.persisted? %>

  <div style="display:flex;gap:.75rem">
    <%= f.submit rule.persisted? ? "Guardar cambios" : "Crear regla",
          style: "padding:.5rem 1.25rem;background:#1a1a2e;color:#fff;border:none;border-radius:6px;font-size:.875rem;cursor:pointer" %>
    <%= link_to "Cancelar", admin_rules_path,
          style: "padding:.5rem 1.25rem;background:#eee;color:#333;border-radius:6px;font-size:.875rem;text-decoration:none" %>
  </div>
<% end %>

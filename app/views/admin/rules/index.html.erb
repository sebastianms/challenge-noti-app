<div class="flex items-center justify-between mb-6">
  <h2 class="text-xl font-semibold text-gray-800">Reglas de notificación</h2>
  <%= link_to "Nueva regla", new_admin_rule_path,
        class: "inline-block px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition" %>
</div>

<% if @rules.empty? %>
  <p class="text-sm text-gray-400">Sin reglas configuradas.</p>
<% else %>
  <%= render "shared/table",
        headers: ["Tipo", "Activa", "Prioridad", "Máx/día", "Cooldown (s)", ""] do %>
    <% @rules.each do |rule| %>
      <tr class="hover:bg-gray-50">
        <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= rule.notification_type %></td>
        <td class="px-4 py-3 text-sm text-center">
          <% if rule.enabled? %>
            <span class="inline-block px-2 py-0.5 text-xs font-medium bg-green-100 text-green-700 rounded-full">Activa</span>
          <% else %>
            <span class="inline-block px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-500 rounded-full">Inactiva</span>
          <% end %>
        </td>
        <td class="px-4 py-3 text-sm text-gray-600"><%= rule.priority.presence || "—" %></td>
        <td class="px-4 py-3 text-sm text-gray-600 text-right"><%= rule.max_per_day || "—" %></td>
        <td class="px-4 py-3 text-sm text-gray-600 text-right"><%= rule.cooldown_seconds || "—" %></td>
        <td class="px-4 py-3 text-sm text-right whitespace-nowrap space-x-3">
          <%= link_to "Editar", edit_admin_rule_path(rule), class: "text-indigo-600 hover:text-indigo-800" %>
          <%= link_to "Historial", history_admin_rule_path(rule), class: "text-gray-500 hover:text-gray-700" %>
          <%= button_to "Eliminar", admin_rule_path(rule), method: :delete,
                form: { data: { turbo_confirm: "¿Eliminar esta regla?" } },
                class: "btn-danger text-sm bg-transparent border-none cursor-pointer text-red-600 hover:text-red-800" %>
        </td>
      </tr>
    <% end %>
  <% end %>
<% end %>

<div class="mt-6">
  <%= render "admin/shared/mock_data_button" %>
</div>

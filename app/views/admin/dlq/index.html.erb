<div class="flex items-center justify-between mb-6">
  <h2 class="text-xl font-semibold text-gray-800">Dead Letter Queue</h2>
</div>

<%= render "admin/shared/mock_data_button" %>

<div class="bg-white rounded-xl border border-gray-200 p-4 mb-4">
  <%= form_with url: admin_dlq_index_path, method: :get, local: true do |f| %>
    <div class="flex items-end gap-3">
      <div class="flex-1">
        <%= f.label :reason, "Clase de error (ej: Net::OpenTimeout)",
              class: "block text-xs font-medium text-gray-600 mb-1" %>
        <%= f.text_field :reason, value: @reason_filter,
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" %>
      </div>
      <%= f.submit "Filtrar",
            class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition cursor-pointer" %>
      <%= link_to "Limpiar", admin_dlq_index_path,
            class: "px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200 transition" %>
    </div>
  <% end %>
</div>

<div class="mb-6">
  <%= form_with url: bulk_retry_admin_dlq_index_path, method: :post, local: true do |f| %>
    <%= f.hidden_field :reason, value: @reason_filter %>
    <%= f.submit "Reintentar todos#{@reason_filter.present? ? " '#{@reason_filter}'" : ''} (cap 500)",
          data: { confirm: "¿Reintentar todos los jobs del filtro actual? Max 500 por operación." },
          disabled: @groups.empty?,
          class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed" %>
  <% end %>
</div>

<% if @groups.empty? %>
  <p class="text-sm text-gray-400">
    No hay jobs en la DLQ<%= " para el filtro '#{@reason_filter}'" if @reason_filter.present? %>.
  </p>
<% else %>
  <div class="space-y-4">
    <% @groups.each do |group| %>
      <details class="bg-white rounded-xl border border-gray-200 overflow-hidden group" open>
        <summary class="flex items-center justify-between px-5 py-3 cursor-pointer hover:bg-gray-50 select-none">
          <span class="text-sm font-semibold text-gray-800"><%= group[:reason_class] %></span>
          <span class="text-xs text-gray-500">
            <%= group[:count] %> job<%= "s" if group[:count] != 1 %>
          </span>
        </summary>

        <div class="overflow-x-auto border-t border-gray-100">
          <table class="admin-table min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event ID</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Intentos</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Motivo</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actualizado</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100">
              <% group[:items].each do |job| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-2 text-sm text-gray-700"><%= job.id %></td>
                  <td class="px-4 py-2 text-sm text-gray-700"><%= job.event_id %></td>
                  <td class="px-4 py-2 text-sm text-gray-600"><%= job.attempts %></td>
                  <td class="px-4 py-2 text-sm text-gray-500 max-w-xs truncate">
                    <%= truncate(job.failed_reason.to_s, length: 80) %>
                  </td>
                  <td class="px-4 py-2 text-xs text-gray-500 whitespace-nowrap">
                    <%= job.updated_at.strftime("%Y-%m-%d %H:%M") %>
                  </td>
                  <td class="px-4 py-2 text-sm whitespace-nowrap">
                    <div class="flex items-center gap-3">
                      <%= button_to "Reintentar", retry_admin_dlq_path(job), method: :post,
                            data: { confirm: "¿Reencolar job ##{job.id}?" },
                            class: "px-3 py-1 text-xs bg-indigo-100 text-indigo-700 rounded hover:bg-indigo-200 transition" %>

                      <%= form_with url: discard_admin_dlq_path(job), method: :post, local: true,
                            class: "flex items-center gap-1" do |f| %>
                        <%= f.text_field :reason, placeholder: "Motivo",
                              class: "px-2 py-1 border border-gray-300 rounded text-xs w-32 focus:outline-none focus:ring-1 focus:ring-red-400" %>
                        <%= f.submit "Descartar",
                              data: { confirm: "¿Descartar job ##{job.id}? No se puede revertir." },
                              class: "btn-danger px-3 py-1 text-xs bg-red-100 text-red-700 rounded hover:bg-red-200 transition cursor-pointer" %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if group[:count] > group[:items].size %>
          <p class="px-5 py-2 text-xs text-gray-400 border-t border-gray-100">
            Mostrando <%= group[:items].size %> de <%= group[:count] %>. Filtra por motivo para ver más.
          </p>
        <% end %>
      </details>
    <% end %>
  </div>
<% end %>

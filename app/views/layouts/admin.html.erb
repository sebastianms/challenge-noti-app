<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Central de Notificaciones — Admin</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: system-ui, sans-serif; display: flex; min-height: 100vh; background: #f5f5f5; color: #222; }
      nav { width: 220px; background: #1a1a2e; color: #eee; padding: 1.5rem 1rem; display: flex; flex-direction: column; gap: .5rem; flex-shrink: 0; }
      nav h1 { font-size: .85rem; text-transform: uppercase; letter-spacing: .1em; color: #aaa; margin-bottom: .5rem; }
      nav a { color: #ddd; text-decoration: none; padding: .4rem .6rem; border-radius: 4px; font-size: .9rem; }
      nav a:hover, nav a.active { background: #16213e; color: #fff; }
      nav .spacer { flex: 1; }
      nav .logout { font-size: .8rem; color: #aaa; }
      main { flex: 1; padding: 2rem; overflow-y: auto; }
      .flash-notice { background: #d4edda; border: 1px solid #c3e6cb; color: #155724; padding: .75rem 1rem; border-radius: 4px; margin-bottom: 1rem; }
      .flash-alert  { background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; padding: .75rem 1rem; border-radius: 4px; margin-bottom: 1rem; }
    </style>
  </head>
  <body>
    <nav>
      <h1>Noti Central</h1>
      <% if admin_user_signed_in? %>
        <% if Admin::RoleAuthorizer.allow?(current_admin_user.role, section: :dashboard) %>
          <%= link_to "Dashboard", admin_dashboard_path, class: request.path.start_with?(admin_dashboard_path) ? "active" : "" %>
        <% end %>
        <% if Admin::RoleAuthorizer.allow?(current_admin_user.role, section: :rules) %>
          <%= link_to "Reglas", admin_rules_path, class: request.path.start_with?(admin_rules_path) ? "active" : "" %>
        <% end %>
        <div class="spacer"></div>
        <span style="font-size:.8rem; color:#aaa; padding: .4rem .6rem"><%= current_admin_user.email %> (<%= current_admin_user.role %>)</span>
        <%= button_to "Cerrar sesión", destroy_admin_user_session_path, method: :delete, class: "logout" %>
      <% end %>
    </nav>
    <main>
      <% if flash[:notice] %>
        <div class="flash-notice"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="flash-alert"><%= flash[:alert] %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
